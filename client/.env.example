# Copy this file to .env and fill in real values. .env is gitignored.

# Base URL of the backend. No trailing slash, the code appends /api/auth and /api/tasks.
# Vite only exposes variables prefixed VITE_, so the name matters.
VITE_API_URL=http://localhost:5000

# Optional. Must match DEMO_USERNAME and DEMO_PASSWORD on the server. Set both
# and the login page offers a one click demo sign in. Leave blank to hide it.
# These are public by design, do not reuse a real password here.
VITE_DEMO_USERNAME=demo
VITE_DEMO_PASSWORD=
