# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB connection string, Atlas cluster or a local mongod.
MONGO_URI=mongodb://127.0.0.1:27017/todo-tasks

# Signs the JWTs. Any long random string, never commit the real one.
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on. Falls back to 5000 if unset.
PORT=5000

# Where the frontend runs. Used for the CORS allowlist, so it must match exactly.
CLIENT_URL=http://localhost:5173

# Optional. The shared account a visitor can try without registering. Set both,
# then run "npm run seed:demo". Rerun it if the database is ever cleared.
DEMO_USERNAME=demo
DEMO_PASSWORD=
